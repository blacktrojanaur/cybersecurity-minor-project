# ==============================================================================
# ZTSP Environment Configuration Template
# Copy this file to .env and customize for your environment.
# NEVER commit secrets to the repository.
# ==============================================================================

# Shared-secret service token for inter-module authorization
SERVICE_TOKEN=dev-secret-change-in-prod

# Service URLs (defaults configured for Docker Compose zt-net)
M1_URL=http://m1_identity:8001
M2_URL=http://m2_policy:8002
M3_URL=http://m3_response:8003
M4_URL=http://m4_posture:8004
M5_URL=http://m5_ml:8005
DASHBOARD_URL=http://dashboard:8080
RESOURCE_APP_URL=http://resource_app:8090
WEBHOOK_URL=http://mock_webhook:8099/webhook

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Machine Learning Parameters
MODEL_SEED=42
TRAIN_NORMAL_COUNT=10000
TRAIN_ATTACK_COUNT=500
CONTAMINATION=0.05
