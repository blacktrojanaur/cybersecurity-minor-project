{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/static/:path*",
      "destination": "/docs/:path*"
    },
    {
      "source": "/",
      "destination": "/docs/index.html"
    },
    {
      "source": "/:match*",
      "destination": "/docs/:match*"
    }
  ]
}

